{
  "expo": {
    "name": "MALLO",
    "slug": "MALLO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mallo-app-icon.png",
    "scheme": "mallo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/mallo-android-icon-foreground.png",
        "backgroundImage": "./assets/images/mallo-android-icon-background.png",
        "monochromeImage": "./assets/images/mallo-android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.malloteam.mallo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "회복 기록에 사진을 추가하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "83dcc01a-72fd-4ba8-9cc5-195342d43afb"
      }
    }
  }
}
