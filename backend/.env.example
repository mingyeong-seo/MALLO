# 이 파일을 복사해서 .env 로 만들고 필요하면 값만 바꿔서 쓰세요.
#   cp .env.example .env
# .env 는 git에 올라가지 않습니다.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mallo
DB_USERNAME=mallo
DB_PASSWORD=mallo1234
DB_ROOT_PASSWORD=root1234

# 콤마로 구분해서 여러 개 등록 가능. 프론트 웹/시뮬레이터 접속 주소가 다르면 여기서 덮어쓰세요.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# 사진 원본 저장 경로 (LocalPhotoStorageAdapter). 로컬 개발은 기본값(./uploads/photos)만 써도 됨 —
# 이 두 줄 자체를 안 넣어도 application.yml 기본값이 적용됨.
# 배포 서버(EC2)에서는 배포 디렉토리(mallo/) 밖의 영구 경로로 반드시 덮어쓸 것 —
# 배포할 때마다 app.jar가 교체돼도 사진은 안 지워지게 하려는 목적. 예:
#   PHOTO_STORAGE_DIR=/home/ec2-user/mallo-uploads/photos
# PHOTO_STORAGE_URL_PREFIX=/uploads/photos
